<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_Wing_RecordType</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$RecordType.Name = &quot;Wing&quot;,
ISBLANK( Tower__c )
)</errorConditionFormula>
