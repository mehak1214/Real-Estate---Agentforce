<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_DP_Reconciled_Percent__c</fullName>
    <formula>IF(Total_Reconciled__c &gt; 0, IF(Opportunity__r.Amount &gt;= Total_Reconciled__c, ( Total_Reconciled__c / Opportunity__r.Amount  ) , 1) , 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total DP Reconciled %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
