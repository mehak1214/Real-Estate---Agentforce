<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>rera_Collected_Percent__c</fullName>
    <formula>IF(rera_Posted_Other__c &gt; 0, IF(rera_Invoice_Amount__c &lt;= rera_Posted_Other__c, ( rera_Posted_Other__c / rera_Invoice_Amount__c ) , 1) , 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>DLD Collected %</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
