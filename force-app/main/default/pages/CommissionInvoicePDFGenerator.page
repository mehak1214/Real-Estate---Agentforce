<apex:page controller="CommissionPDFController" 
           applyHtmlTag="false" 
           showHeader="false" 
           renderAs="PDF">
    
    <head>
        <style>
            body {
            font-family: Arial, Helvetica, sans-serif;
            }
            .header {
            text-align: center;
            margin: 20px;
            }
            .title {
            background-color: #8B0000;
            color: white;
            text-align: center;
            padding: 8px;
            width: 40%;
            margin: 0 auto 20px auto;
            font-weight: bold;
            }
            table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            }
            th, td {
            border: 1px solid black;
            padding: 6px;
            text-align: center;
            }
            th {
            background-color: #8B0000;
            color: white;
            }
            .summary td {
            font-weight: bold;
            }
        </style>
    </head>
    
    <!-- Header -->
    <div class="header">
        <h2>Commission Invoice</h2>
    </div>
    
    <div class="title">
        TAX INVOICE
    </div>
    
    <!-- Data Table -->
    <div style="margin: 20px;">
        <table>
            <thead>
                <tr>
                    <th>Sl. No</th>
                    <th>Name</th>
                    <th>Broker</th>
                    <th>Unit</th>
                    <th>Unit Cost</th>
                    <th>Commission %</th>
                    <th>Amount</th>
                    <th>VAT</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat value="{!invoiceLineItems}" var="line">
                    <tr>
                        <td>{!line.srNo}</td>
                        <td>{!line.name}</td>
                        <td>{!line.broker}</td>
                        <td>{!line.unit}</td>
                        <td>{!line.unitCost}</td>
                        <td>{!line.percent}</td>
                        <td>{!line.amount}</td>
                        <td>{!line.vat}</td>
                        <td>{!line.total}</td>
                    </tr>
                </apex:repeat>
                
                <!-- Totals -->
                <tr class="summary">
                    <td colspan="6">TOTAL</td>
                    <td>{!totalAmount}</td>
                    <td>{!totalvatAmount}</td>
                    <td>{!totalAmountWithVAT}</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- Footer -->
    <div style="margin: 20px;">
        <table>
            <tr>
                <td style="text-align:left;">Authorized Signature</td>
                <td></td>
            </tr>
            <tr>
                <td style="text-align:left;">Date</td>
                <td></td>
            </tr>
        </table>
    </div>
    
</apex:page>