<apex:page controller="CommissionPDFController" 
           applyHtmlTag="false" 
           showHeader="false" 
           renderAs="PDF">
    
    <head>
        <style>
            body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: #333;
            }
            .header {
            text-align: center;
            margin: 20px;
            }
            .title {
            background-color: #8B0000;
            color: white;
            text-align: center;
            padding: 8px;
            width: 40%;
            margin: 0 auto 20px auto;
            font-weight: bold;
            }
            /* Sales Order Info Section */
            .so-info-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0 20px 20px 20px;
            font-size: 12px;
            }
            .so-info-table td {
            padding: 4px 8px;
            border: none;
            }
            .so-info-table .label-cell {
            font-weight: bold;
            width: 160px;
            color: #555;
            }
            .so-info-table .value-cell {
            color: #222;
            }
            .section-divider {
            border: none;
            border-top: 1px solid #ccc;
            margin: 10px 20px 20px 20px;
            }
            table.data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            }
            table.data-table th, table.data-table td {
            border: 1px solid black;
            padding: 6px;
            text-align: center;
            }
            table.data-table th {
            background-color: #8B0000;
            color: white;
            }
            .summary td {
            font-weight: bold;
            }
        </style>
    </head>
    
    <!-- Header -->
    <div class="header">
        <h2>Commission Invoice</h2>
    </div>
    
    <div class="title">
        TAX INVOICE
    </div>
    
    <!-- Sales Order Details (only when generated from Sales Order) -->
    <apex:outputPanel rendered="{!isSalesOrderMode}">
        <div style="margin: 0 20px 10px 20px;">
            <table class="so-info-table">
                <tr>
                    <td class="label-cell">Sales Order #:</td>
                    <td class="value-cell">{!salesOrderNumber}</td>
                    <td class="label-cell">Invoice Date:</td>
                    <td class="value-cell">{!invoiceDate}</td>
                </tr>
                <tr>
                    <td class="label-cell">Project:</td>
                    <td class="value-cell">{!projectName}</td>
                    <td class="label-cell">Status:</td>
                    <td class="value-cell">{!orderStatus}</td>
                </tr>
                <tr>
                    <td class="label-cell">Unit:</td>
                    <td class="value-cell">{!unitName}</td>
                    <td class="label-cell">Net Amount:</td>
                    <td class="value-cell">{!netAmount}</td>
                </tr>
            </table>
        </div>
        <hr class="section-divider"/>
    </apex:outputPanel>
    
    <!-- Data Table -->
    <div style="margin: 20px;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Sl. No</th>
                    <th>Name</th>
                    <th>Broker</th>
                    <th>Unit</th>
                    <th>Unit Cost</th>
                    <th>Commission %</th>
                    <th>Status</th>
                    <th>Amount</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat value="{!invoiceLineItems}" var="line">
                    <tr>
                        <td>{!line.srNo}</td>
                        <td>{!line.name}</td>
                        <td>{!line.broker}</td>
                        <td>{!line.unit}</td>
                        <td>{!line.unitCost}</td>
                        <td>{!line.percent}</td>
                        <td>{!line.status}</td>
                        <td>{!line.amount}</td>
                        <td>{!line.total}</td>
                    </tr>
                </apex:repeat>
                
                <!-- Totals -->
                <tr class="summary">
                    <td colspan="7">TOTAL</td>
                    <td>{!totalAmount}</td>
                    <td>{!totalAmount}</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- Footer -->
    <div style="margin: 20px;">
        <table class="data-table">
            <tr>
                <td style="text-align:left;">Authorized Signature</td>
                <td></td>
            </tr>
            <tr>
                <td style="text-align:left;">Date</td>
                <td></td>
            </tr>
        </table>
    </div>
    
</apex:page>